<article class="resource-summary">
  <h2 class="resource-summary__title"><a href="{{resource.detailUrl}}">{{resource.title}}</a></h2>
  <p class="resource-summary__meta">
    Thesis{{#if resource.degreeType}} · {{resource.degreeType}}{{/if}}
  </p>
  <span class="status-badge status-badge--{{resource.accessStatusTone}}">{{resource.accessStatusLabel}}</span>
</article>
